package dungeon

import "testing"

// The claim ledger's retention rule is the one piece of the exactly-once
// argument that is pure logic, so it gets a table test here; the rest of the
// argument (the ledger is written in the same transaction as the reward, and
// only the run.State the session service returned earns one) is asserted end
// to end by the robot scenario, which finishes a run twice and requires the
// second answer to grant nothing.
func TestClaimExpiredKeepsAClaimWellPastTheRunTTL(t *testing.T) {
	const now int64 = 1_800_000_000
	// session.run_ttl in the generated configuration is 30 minutes. A claim
	// must survive at least that long, or a replay arriving while the run is
	// still finishable would be paid a second time.
	const runTTL int64 = 30 * 60
	for name, test := range map[string]struct {
		claimedAt int64
		expired   bool
	}{
		"just recorded":        {now, false},
		"one run ttl old":      {now - runTTL, false},
		"twice the run ttl":    {now - 2*runTTL, false},
		"just inside the hold": {now - ClaimRetentionSeconds, false},
		"just past the hold":   {now - ClaimRetentionSeconds - 1, true},
		"absent":               {0, true},
		"negative":             {-1, true},
	} {
		if got := ClaimExpired(test.claimedAt, now); got != test.expired {
			t.Errorf("%s: ClaimExpired(%d, %d) = %v, want %v", name, test.claimedAt, now, got, test.expired)
		}
	}
	if ClaimRetentionSeconds <= runTTL {
		t.Errorf("the claim hold (%ds) must outlast session.run_ttl (%ds) or a replayable run can be paid twice", ClaimRetentionSeconds, runTTL)
	}
}
