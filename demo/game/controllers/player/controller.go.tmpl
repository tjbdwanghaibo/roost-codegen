// Transport is the push side of the player connection. It is looked up
// lazily: the binding constructs the controller while Mods are still being
// provided, and the transport Mod may publish its Runtime after this one.
func (controller *Controller) Transport() (pushTransport, error) {
	if controller == nil {
		return nil, errors.New("player controller: nil")
	}
	if runtime := controller.transport.Load(); runtime != nil {
		return *runtime, nil
	}
	runtime, ok := app.Lookup[pushTransport](controller.registry, playerTCPCapability)
	if !ok || runtime == nil {
		return nil, fmt.Errorf("player controller: capability %q not found; the player tcp transport is not assembled", playerTCPCapability)
	}
	controller.transport.Store(&runtime)
	return runtime, nil
}

// Battles is the battle manager, looked up lazily: the service registers it
// in Init, after the protocol binding has built this controller.
func (controller *Controller) Battles() (battleRouter, error) {
	if controller == nil {
		return nil, errors.New("player controller: nil")
	}
	if router := controller.battles.Load(); router != nil {
		return *router, nil
	}
	router, ok := app.Lookup[battleRouter](controller.registry, battleCapability)
	if !ok || router == nil {
		return nil, fmt.Errorf("player controller: capability %q not found; the battle manager is not running", battleCapability)
	}
	controller.battles.Store(&router)
	return router, nil
}

// Ranking is the leaderboard service.
func (controller *Controller) Ranking() svcrank.Rank {
	if controller == nil {
		return nil
	}
	return controller.ranking
}

// Scene is the replicated world, looked up lazily like the battle manager.
func (controller *Controller) Scene() (sceneJoiner, error) {
	if controller == nil {
		return nil, errors.New("player controller: nil")
	}
	if joiner := controller.scene.Load(); joiner != nil {
		return *joiner, nil
	}
	joiner, ok := app.Lookup[sceneJoiner](controller.registry, sceneCapability)
	if !ok || joiner == nil {
		return nil, fmt.Errorf("player controller: capability %q not found; the scene is not running", sceneCapability)
	}
	controller.scene.Store(&joiner)
	return joiner, nil
}

// WorldSceneID is the full entity id of the one map this process runs.
func (controller *Controller) WorldSceneID() int64 {
	if controller == nil {
		return 0
	}
	return controller.sceneID
}

// WorldID is the full entity id of this process's World.
func (controller *Controller) WorldID() int64 {
	if controller == nil {
		return 0
	}
	return controller.worldID
}
