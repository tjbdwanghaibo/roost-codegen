package handler

import player "{{MODULE}}/game/entities/player"

// handlerGiftDebit is the gift saga's debit step as a Nest transaction: take
// count of itemID out of the sender's Bag. Its compensation is the existing
// AddItem transaction (the refund). Both are ordinary transactions — the
// saga step around them (internal/service/<game>/gift_saga.go) is what makes
// a redelivered command not run them twice.
//
//roost:nest rollback=undo durability=strict
func handlerGiftDebit(target player.IBagEntity, itemID int64, count int32) (int32, error) {
	return target.BagComp().RemoveItem(itemID, count)
}
