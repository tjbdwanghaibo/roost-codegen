package {{GAME_SERVICE_PKG}}

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"time"

	world "{{MODULE}}/game/entities/world"
	syncsender "{{MODULE}}/game/handler/syncsender"
	lifecycle "{{MODULE}}/game/lifecycle"
	"{{MODULE}}/game/matchmaking"
	accessplayertcp "{{MODULE}}/internal/access/player/tcp"
	"{{MODULE}}/protocol/msgid"
	"{{MODULE}}/protocol/pb"
	"github.com/tjbdwanghaibo/roost-core/app"
	"github.com/tjbdwanghaibo/roost-core/entity"
	corenest "github.com/tjbdwanghaibo/roost-core/nest"
	svcmatch "github.com/tjbdwanghaibo/roost-kit/service/match"
)

const (
	// matchmakerInterval is how often this process tries to form groups.
	matchmakerInterval = 500 * time.Millisecond
	// matchmakerWindow bounds how many waiting tickets one pass reads.
	matchmakerWindow = 64
)

// startMatchmaker drives the match service's queue for this game.
//
// The match service holds the queue and makes Commit atomic, but it does not
// decide who plays with whom: Candidates hands back the waiting tickets and
// Commit takes a group. Deciding is a game policy, so it runs here, in the
// game process, with a Grouping — the same interface the match Mod is built
// around. Every call into the match service is a typed servicerpc call
// through the generated client (see framework_clients_gen.go), made from a
// plain goroutine: never from inside an Entity lock, which is why the World
// only learns about a match afterwards, through its own Nest handler.
func startMatchmaker(ctx context.Context, registry *app.Registry, battles *battleManager, scene *Scene) (func(), error) {
	matcher, err := Match(registry)
	if err != nil {
		return nil, fmt.Errorf("matchmaker: %w", err)
	}
	nestClient, ok := app.Lookup[corenest.Client](registry, app.ModName("nest"))
	if !ok || nestClient == nil {
		return nil, errors.New("matchmaker: nest client is unavailable")
	}
	worldID, err := entity.BuildEntityID(lifecycle.WorldUniqueID, world.EntityKindWorld)
	if err != nil {
		return nil, fmt.Errorf("matchmaker: %w", err)
	}
	// The transport Runtime is the push side of the player connection. It is
	// looked up once; PushPlayer fails cleanly while the listener is off.
	transport, ok := app.Lookup[*accessplayertcp.Runtime](registry, accessplayertcp.Name)
	if !ok || transport == nil {
		return nil, errors.New("matchmaker: player tcp runtime is unavailable")
	}
	loopCtx, cancel := context.WithCancel(ctx)
	done := make(chan struct{})
	go func() {
		defer close(done)
		ticker := time.NewTicker(matchmakerInterval)
		defer ticker.Stop()
		recorder := syncsender.NewRecordMatchSender(nestClient)
		// Two pools, two policies: duel in arrival order, ranked by level
		// inside a widening window. The policies live here, in the game
		// process, not in the match service.
		pools := matchmaking.Pools(func() int64 { return time.Now().Unix() })
		for {
			select {
			case <-loopCtx.Done():
				return
			case <-ticker.C:
			}
			for _, pool := range pools {
				if err := formMatches(loopCtx, matcher, pool.Queue, pool.Grouping, recorder, transport, battles, scene, worldID); err != nil && loopCtx.Err() == nil {
					slog.Warn("matchmaker: pass failed", "queue", pool.Queue.Key(), "err", err)
				}
			}
		}
	}()
	return func() {
		cancel()
		<-done
	}, nil
}

// formMatches drains as many groups as the policy can form from one window
// of candidates. A Commit that loses a race (a ticket was cancelled or taken
// meanwhile) is not an error of this pass: the next tick reads fresh
// candidates.
func formMatches(ctx context.Context, matcher svcmatch.Matchmaker, queue svcmatch.Queue, grouping svcmatch.Grouping, recorder *syncsender.RecordMatchSender, transport *accessplayertcp.Runtime, battles *battleManager, scene *Scene, worldID int64) error {
	candidates, err := matcher.Candidates(ctx, queue, matchmakerWindow)
	if err != nil {
		return fmt.Errorf("candidates: %w", err)
	}
	for len(candidates) >= queue.GroupSize {
		group, formed, err := grouping.Group(queue, candidates)
		if err != nil {
			return fmt.Errorf("grouping: %w", err)
		}
		if !formed {
			return nil
		}
		ids := make([]string, 0, len(group))
		taken := make(map[string]bool, len(group))
		for _, ticket := range group {
			ids = append(ids, ticket.ID)
			taken[ticket.ID] = true
		}
		match, err := matcher.Commit(ctx, queue, ids)
		if err != nil {
			if errors.Is(err, svcmatch.ErrTicketMissing) || errors.Is(err, svcmatch.ErrTicketMatched) || errors.Is(err, svcmatch.ErrConflict) {
				return nil
			}
			return fmt.Errorf("commit: %w", err)
		}
		slog.Info("matchmaker: match formed", "queue", queue.Key(), "match_id", match.ID, "members", len(match.Members))
		if err := recorder.Sync_RecordMatch(ctx, worldID); err != nil {
			// The match exists either way; the counter is bookkeeping.
			slog.Warn("matchmaker: world did not record the match", "match_id", match.ID, "err", err)
		}
		// Tell the players. PushPlayer reaches every authenticated session of
		// the player; one who has gone offline gets ErrSessionNotFound and
		// finds the match through PollMatch when they are back — the ticket
		// keeps the match id either way, so the push is a shortcut, not the
		// source of truth.
		members := make([]int64, 0, len(match.Members))
		for _, member := range match.Members {
			members = append(members, member.ID)
		}
		// The lockstep room opens before the push goes out: a client that
		// answers MatchFound with its first input must find the battle
		// already there. The room is in this process, so only the process
		// that formed the match hosts the battle — a deployment with
		// several game processes gives battles their own service and
		// addresses it by match id.
		if err := battles.Open(match.ID, members); err != nil {
			slog.Error("matchmaker: battle not opened", "match_id", match.ID, "err", err)
		}
		// A formed match is the demo's one social relationship: teammates see
		// each other's state wherever they are, which is what a team frame or
		// a minimap needs. It goes through the scene's relation source, so it
		// is the same machinery as distance — and a teammate who is ALSO
		// nearby is held by both, released only when the last one lets go.
		if scene != nil {
			scene.SetTeam(members)
		}
		push := &pb.MatchFoundPush{MatchID: match.ID, Members: members}
		for _, member := range match.Members {
			if err := transport.PushPlayer(ctx, member.ID, msgid.MsgMatchFound, push); err != nil {
				slog.Debug("matchmaker: match push not delivered", "match_id", match.ID, "player_id", member.ID, "err", err)
			}
		}
		remaining := candidates[:0]
		for _, ticket := range candidates {
			if !taken[ticket.ID] {
				remaining = append(remaining, ticket)
			}
		}
		candidates = remaining
	}
	return nil
}
