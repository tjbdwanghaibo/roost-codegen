// PlayerOwnerCapability is the name the ownership table is published under, so
// an endpoint can reach it without importing this package.
const PlayerOwnerCapability app.ModName = "{{GAME_SERVICE}}.playerowner"

// Who owns which player, in a deployment with more than one game process.
//
// The rule this enforces is one sentence: **a Player is written only by the
// process that owns it.** Everything else here follows from it.
//
//	login          claim the player for this process (game/playerroute)
//	while loaded   refresh the claim, so a resident player is never re-owned
//	process gone   the lease lapses and somebody else may take them
//	background     ask before touching a player at all
//
// Note what is NOT in that list: the connection closing. The claim tracks
// where the Player ENTITY lives, not where its socket is. A Player stays
// resident in the process that loaded it after the player disconnects —
// nothing in the demo evicts one — so a process that gave the claim up at
// session close would still be holding the document, and the next process to
// take the claim would load a second copy of it. That is the same corruption
// as below, reached the slow way; measured on the two-process run, six gift
// steps for logged-out players moved to the other process within seconds of
// their robots finishing. Ownership therefore ends when the entity does
// (Release, from a destroy) or when the lease lapses because the process is
// gone — and those are the only two honest statements about a resident entity.
//
// The last line of the table is the one that matters for correctness, and it
// is the reason this exists at all: the saga step consumers and the effect consumers share
// one JetStream durable across every game process, so a message about player X
// is delivered to WHICHEVER process is free — not to the one that has X
// loaded. Before this, that process would load X too, and the two of them
// would write the same document with two independent version counters. The
// first run of the demo with two processes ended in
// `fatal projection version conflict` and a dead process, within seconds.
//
// One more rule, and it is the one that makes the table worth anything:
// **holding a claim is not the same as knowing you still hold it.** A renewal
// that fails leaves this process in the dark, and 30 seconds later another
// process may legitimately take the player. Writing until somebody tells you
// to stop is therefore not an option — nobody will. Every write path asks
// Admit, which answers from the last renewal Redis CONFIRMED, and refuses as
// the confirmed lease runs out (RR-20260920-04).
type PlayerOwners struct {
	store    leaseTable
	fencer   sessionFencer
	guard    time.Duration
	now      func() time.Time

	mu    sync.Mutex
	local map[int64]*leaseState
	stop  chan struct{}
	done  chan struct{}
}

// leaseTable is the shared table as these owners use it. The interface exists
// so the fencing rules can be tested without a Redis; *playerroute.Store is
// the implementation.
type leaseTable interface {
	Claim(ctx context.Context, playerID int64) (playerroute.Route, error)
	Owner(ctx context.Context, playerID int64) (playerroute.Route, error)
	Owns(ctx context.Context, playerID int64) (bool, error)
	// GetRoute is the addressing question — who should this work go to —
	// which is the table's view, not this process's admission. A router that
	// asked the gate here would refuse to address work to anybody.
	GetRoute(ctx context.Context, playerID int64) (playerroute.Route, bool, error)
	Refresh(ctx context.Context, playerIDs []int64) []playerroute.RefreshResult
	Release(ctx context.Context, playerID int64) error
	SID() int32
}

// sessionFencer is how a process stops serving a player it can no longer
// prove it owns: it disconnects them. The player reconnects — to whichever
// process owns them by then, which is the point.
type sessionFencer interface {
	CloseSessions(playerID int64, reason error) int
}

// leaseState is what this process knows about one lease, and when it stops
// being able to claim it knows it. validUntil is a LOCAL deadline computed
// from the last confirmation, never from the value in Redis: the two clocks
// are different and the local one is the one the writes race against.
type leaseState struct {
	validUntil time.Time
	lost       bool
}

// ErrLeaseNotHeld is what a write path gets when this process cannot prove it
// owns the player right now.
var ErrLeaseNotHeld = errors.New("player owners: this process does not hold a confirmed lease on the player")

// AdmissionGuard is how much of the lease is reserved for work already in
// flight. A transaction admitted at the last confirmed moment must finish
// before the lease can lapse, so admission stops this long before the
// deadline; anything slower than the guard is the one thing this cannot
// protect, and it is far outside what a Nest transaction takes.
const AdmissionGuard = 5 * time.Second

// NewPlayerOwners builds the table from what the process publishes.
func NewPlayerOwners(registry *app.Registry) (*PlayerOwners, error) {
	client, err := mods.Redis(registry)
	if err != nil {
		return nil, fmt.Errorf("player owners: %w", err)
	}
	config := registry.Config()
	sid := int32(config.GetInt("sid"))
	prefix := config.GetString("game_route.key_prefix")
	if prefix == "" {
		return nil, fmt.Errorf("player owners: game_route.key_prefix is empty; ownership is a shared fact and needs a keyspace")
	}
	store, err := playerroute.NewStore(client, prefix, sid)
	if err != nil {
		return nil, fmt.Errorf("player owners: %w", err)
	}
	return newPlayerOwners(store, nil, time.Now), nil
}

// newPlayerOwners is the seam the tests build through.
func newPlayerOwners(store leaseTable, fencer sessionFencer, now func() time.Time) *PlayerOwners {
	if now == nil {
		now = time.Now
	}
	return &PlayerOwners{
		store: store, fencer: fencer, guard: AdmissionGuard, now: now,
		local: map[int64]*leaseState{},
	}
}

// Fence sets what disconnects a player this process may no longer serve. It
// is separate from construction because the transport comes up after the
// table does.
func (owners *PlayerOwners) Fence(fencer sessionFencer) {
	if owners == nil {
		return
	}
	owners.mu.Lock()
	owners.fencer = fencer
	owners.mu.Unlock()
}

// Start begins refreshing this process's claims.
//
// It deliberately does not subscribe to session closes. See the type comment:
// the Player entity outlives the connection, so releasing here would give the
// claim away while this process still holds the document.
func (owners *PlayerOwners) Start(ctx context.Context) {
	if owners == nil {
		return
	}
	owners.stop, owners.done = make(chan struct{}), make(chan struct{})
	go owners.refreshLoop(ctx)
}

func (owners *PlayerOwners) refreshLoop(ctx context.Context) {
	defer close(owners.done)
	ticker := time.NewTicker(playerroute.RefreshInterval)
	defer ticker.Stop()
	for {
		select {
		case <-ctx.Done():
			return
		case <-owners.stop:
			return
		case <-ticker.C:
		}
		owners.renew(ctx)
	}
}

// renew is one pass of the refresh loop, factored out so a test can drive it
// without waiting for a ticker.
func (owners *PlayerOwners) renew(ctx context.Context) {
	for _, result := range owners.store.Refresh(ctx, owners.snapshot()) {
		switch {
		case result.Held:
			owners.confirm(result.PlayerID)
		case result.Err != nil:
			// UNKNOWN. The lease may still be ours, so this does not give it
			// up — but it does not extend the deadline either, and admission
			// runs out on its own if the next renewals keep failing. That is
			// the whole difference between a process that stops in time and
			// one that is still writing when somebody else takes over.
			slog.Warn("player owners: lease renewal failed; admission is running out", "player_id", result.PlayerID, "err", result.Err)
		default:
			// Redis answered, and the answer is that the lease is not ours.
			// Two different situations wear that answer, and they deserve
			// different endings:
			//
			//   nobody holds it   our renewals lapsed while the player stayed
			//                     here. Taking it again is atomic (SetNX), it
			//                     is correct, and it does not disturb anyone.
			//   somebody holds it another process owns this player now; this
			//                     one must stop serving them.
			//
			// The re-claim decides which it is, so this does not have to
			// guess — and a lost re-claim is exactly the case that must
			// fence.
			mine, err := owners.Claim(ctx, result.PlayerID)
			switch {
			case err != nil:
				slog.Warn("player owners: lease lost and could not be retaken; admission is running out", "player_id", result.PlayerID, "err", err)
			case mine:
				slog.Warn("player owners: lease had lapsed and was retaken", "player_id", result.PlayerID)
			default:
				owners.fence(result.PlayerID, "another process holds the lease now")
			}
		}
	}
}

// confirm records that Redis just said the lease is ours.
func (owners *PlayerOwners) confirm(playerID int64) {
	owners.mu.Lock()
	defer owners.mu.Unlock()
	state := owners.local[playerID]
	if state == nil {
		state = &leaseState{}
		owners.local[playerID] = state
	}
	state.validUntil = owners.now().Add(playerroute.Lease)
	state.lost = false
}

// fence stops this process from serving a player it can no longer prove it
// owns: the lease is dropped locally, every write path starts refusing, and
// the player's connections are closed so they stop sending work. Their
// session-close path then runs the ordinary cleanups.
//
// It does NOT release the claim in Redis: either somebody else already holds
// it — in which case releasing would delete THEIR lease — or the state is
// unknown, where the safe move is to let it lapse.
func (owners *PlayerOwners) fence(playerID int64, reason string) {
	owners.mu.Lock()
	state := owners.local[playerID]
	if state == nil || state.lost {
		owners.mu.Unlock()
		return
	}
	state.lost = true
	delete(owners.local, playerID)
	fencer := owners.fencer
	owners.mu.Unlock()
	closed := 0
	if fencer != nil {
		closed = fencer.CloseSessions(playerID, fmt.Errorf("player owners: %s", reason))
	}
	slog.Warn("player owners: fenced a player this process no longer owns", "player_id", playerID, "reason", reason, "sessions_closed", closed)
}

// Admit is the write gate: may this process start a new transaction on this
// player right now?
//
// It answers from local state on purpose — a Redis round trip per action
// would cost more than the lease is worth, and would not be more true: the
// answer can go stale a microsecond after any read. What makes the local
// answer sound is that it is derived from the last renewal Redis CONFIRMED,
// and that it expires on its own.
func (owners *PlayerOwners) Admit(playerID int64) error {
	if owners == nil {
		// No table: a single-process deployment, where every player is ours.
		return nil
	}
	owners.mu.Lock()
	defer owners.mu.Unlock()
	state := owners.local[playerID]
	if state == nil || state.lost {
		return fmt.Errorf("%w: player %d", ErrLeaseNotHeld, playerID)
	}
	if remaining := state.validUntil.Sub(owners.now()); remaining <= owners.guard {
		return fmt.Errorf("%w: player %d, confirmed lease has %s left and admission needs %s", ErrLeaseNotHeld, playerID, remaining, owners.guard)
	}
	return nil
}

// AdmitMessage is the access boundary's gate (accessplayer.WriteGate): may
// this process act on this request at all?
//
// Login is exempt, and it has to be: it is the message that TAKES ownership,
// so gating it on already having ownership would lock every player out. Every
// other message is refused while this process cannot prove it owns the
// player — which covers endpoints that do not exist yet, the reason the check
// lives here rather than in each handler.
func (owners *PlayerOwners) AdmitMessage(playerID int64, messageID uint32) error {
	if owners == nil {
		return nil
	}
	if messageID == msgid.MsgEnterGame {
		return nil
	}
	return owners.Admit(playerID)
}

// Admitted reports Admit as a boolean, for callers that only branch on it.
func (owners *PlayerOwners) Admitted(playerID int64) bool { return owners.Admit(playerID) == nil }

// Stop ends the refresh loop. Claims are left to expire rather than released:
// a process going down does not know whether it is coming back, and a lease
// that runs out is the only statement that is true either way.
func (owners *PlayerOwners) Stop() {
	if owners == nil || owners.stop == nil {
		return
	}
	close(owners.stop)
	<-owners.done
	owners.stop = nil
}

// Claim takes ownership at login and reports whether this process got it.
//
// Losing the claim is not an error here: it means the player is still owned by
// another process — usually because they logged in there and their session has
// not finished closing. The caller decides; the login path lets them in and
// logs it, because refusing a login over a stale lease is worse than two
// processes briefly disagreeing about a player who is doing nothing.
func (owners *PlayerOwners) Claim(ctx context.Context, playerID int64) (bool, error) {
	if owners == nil {
		return false, nil
	}
	route, err := owners.store.Claim(ctx, playerID)
	if err != nil {
		return false, err
	}
	mine := route.SID == owners.store.SID()
	if mine {
		owners.confirm(playerID)
	}
	return mine, nil
}

// Release gives up a claim. The caller is stating that this process no longer
// holds the Player entity — a destroy, or an operator moving them — NOT that
// the player disconnected. Releasing a resident entity's claim invites a
// second copy of it in another process.
func (owners *PlayerOwners) Release(ctx context.Context, playerID int64) {
	if owners == nil {
		return
	}
	owners.mu.Lock()
	delete(owners.local, playerID)
	owners.mu.Unlock()
	if err := owners.store.Release(ctx, playerID); err != nil {
		slog.Warn("player owners: claim not released", "player_id", playerID, "err", err)
	}
}

// Owns is the question a background consumer asks before touching a player.
//
// "Nobody owns them" answers TRUE: an offline player has no process to defer
// to, and refusing would leave their mail, their saga steps and their paid
// orders undone forever. The claim that goes with it is what keeps two
// processes from both deciding that — Claim is insert-only, so exactly one of
// them wins and the other sees the winner.
func (owners *PlayerOwners) Owns(ctx context.Context, playerID int64) (bool, error) {
	if owners == nil {
		return true, nil
	}
	// Already ours and still admitted: no round trip, and — more importantly
	// — the same answer every other write path gets. A consumer that asked
	// Redis directly could be admitted here while Admit refuses two lines
	// later, which is how you end up with half a rule.
	if owners.Admitted(playerID) {
		return true, nil
	}
	route, err := owners.store.Owner(ctx, playerID)
	if err != nil {
		return false, err
	}
	if route.SID == 0 {
		mine, claimErr := owners.Claim(ctx, playerID)
		return mine, claimErr
	}
	if route.SID != owners.store.SID() {
		return false, nil
	}
	// Redis says this sid owns them but this process has no confirmed lease:
	// it is a previous incarnation's claim, or one this process gave up. Not
	// ours to write through until a Claim confirms it.
	return false, nil
}

// OwnedHere answers the same question as Owns without the claim. It is for
// callers that are only deciding whether to act on a player they did not ask
// for — a matchmaker draining a shared queue, an operator surface — where
// taking ownership as a side effect of looking would pull idle players into
// whichever process happened to glance at them.
func (owners *PlayerOwners) OwnedHere(ctx context.Context, playerID int64) (bool, error) {
	if owners == nil {
		return true, nil
	}
	// The gate first, for the same reason as Owns: one answer, one rule.
	if owners.Admitted(playerID) {
		return true, nil
	}
	held, err := owners.store.Owns(ctx, playerID)
	if err != nil || !held {
		return false, err
	}
	// Redis agrees it is this sid's, but there is no confirmed local lease
	// behind it. Answering true here would let a caller act on a lease this
	// process cannot prove it still holds.
	return false, nil
}

// OwnerSID reports who owns a player, or 0 for nobody. It is what an operator
// surface answers with when the work belongs somewhere else.
func (owners *PlayerOwners) OwnerSID(ctx context.Context, playerID int64) (int32, error) {
	if owners == nil {
		return 0, nil
	}
	route, err := owners.store.Owner(ctx, playerID)
	return route.SID, err
}

// SID is this process's server id, which is what the router compares a route
// against to decide local or remote.
func (owners *PlayerOwners) SID() int32 {
	if owners == nil {
		return 0
	}
	return owners.store.SID()
}

// Routes is the resolver the core router uses.
func (owners *PlayerOwners) Routes() ownerroute.Resolver[int64, playerroute.Route] {
	return owners.store
}

func (owners *PlayerOwners) snapshot() []int64 {
	owners.mu.Lock()
	defer owners.mu.Unlock()
	out := make([]int64, 0, len(owners.local))
	for playerID := range owners.local {
		out = append(out, playerID)
	}
	return out
}
