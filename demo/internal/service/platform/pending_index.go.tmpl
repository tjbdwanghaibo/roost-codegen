package Platform

import (
	"context"
	"fmt"
	"sync"

	"{{MODULE}}/game/purchase"
	"github.com/tjbdwanghaibo/roost-core/app"
	fredis "github.com/tjbdwanghaibo/roost-core/redis"
	"github.com/tjbdwanghaibo/roost-kit/mods"
	"github.com/tjbdwanghaibo/roost-kit/service/platform"
)

// The paid-but-undelivered index.
//
// The platform service retries deliveries in the background, but it cannot
// enumerate what is waiting: scanning a keyspace on a timer is the shape that
// package refuses, so `PendingOrders` is a collaborator the deployment
// supplies (U-0234 gave it the entry point and left the index itself to the
// deployment). This is a deployment's implementation of it, and the four
// things it has to get right are the four things a retry loop gets wrong:
//
//   - **Survive a restart.** An index in memory means every order that was
//     waiting when the process died waits forever. This one is a Redis sorted
//     set beside the order records.
//   - **Page.** A backlog of fifty thousand orders must not become one slice:
//     the reader takes the limit the loop offers and the rest wait a tick.
//   - **Be fair.** Scored by when the order is next worth an attempt and read
//     lowest-score-first, so an order that keeps failing cannot starve the
//     ones behind it — failing moves its own score forward.
//   - **Retire.** A delivered order left in the index is read every tick
//     forever.
//
// Retirement is the part worth reading. This index does not decide that an
// order is finished: it asks the service that owns the record, on the read,
// and drops the entry when the answer is "terminal" or "gone". The delivering
// side cannot make that decision — an order can also end as exhausted or as
// settled by an operator, and neither passes through a deliverer — so an
// index that retired entries by watching its own writes would keep exactly
// the orders a human already dealt with.
type pendingIndex struct {
	mu       sync.Mutex
	registry *app.Registry
	client   indexStore
	key      string
	// orders is the platform service itself, looked up on first use: the
	// capability is published after Provide returns, so binding is too early
	// to resolve it.
	orders platform.Platform
	now    func() int64
}

// indexStore is the slice of the Redis client this index uses. It is narrowed
// to three calls so the index's own promises — page, order, retire — can be
// tested against a fake that is a map, rather than against a Redis: a fake
// that has to implement fifty methods is a fake nobody writes, and untested
// index logic is how a retry loop quietly stops retrying.
type indexStore interface {
	ZAdd(ctx context.Context, key string, members ...fredis.Z) (int64, error)
	ZRem(ctx context.Context, key string, members ...any) (int64, error)
	ZRangeWithScores(ctx context.Context, key string, start, stop int64) ([]fredis.Z, error)
}

// BindRegistry implements platform.RegistryBound: the index keeps its entries
// in the same Redis the service stores orders in, and the client only exists
// once the process's Mods have published it.
func (index *pendingIndex) BindRegistry(registry *app.Registry) error {
	client, err := mods.Redis(registry)
	if err != nil {
		return err
	}
	prefix, err := mods.KeyPrefix(registry.Config(), "platform")
	if err != nil {
		return err
	}
	index.mu.Lock()
	defer index.mu.Unlock()
	index.registry, index.client, index.key = registry, client, purchase.PendingKey(prefix)
	return nil
}

// track records that an order is waiting, scored by when it is next worth an
// attempt. It is called on the delivery path, before the grant is written, so
// a process that dies mid-delivery leaves the order findable.
//
// It cannot be perfectly atomic with the order record — the record is written
// by the service, in a different call — so there remains a window in which an
// order exists and is not indexed. The window is one function call wide and
// the channel's own callback retry covers it; closing it entirely would mean
// the index and the record sharing one write, which is the order store's job,
// not an index's.
func (index *pendingIndex) track(ctx context.Context, orderID string, dueUnix int64) error {
	client, key := index.handle()
	if client == nil {
		return fmt.Errorf("pending index: not bound to a registry")
	}
	if _, err := client.ZAdd(ctx, key, fredis.Z{Score: float64(dueUnix), Member: orderID}); err != nil {
		return fmt.Errorf("pending index: track %s: %w", orderID, err)
	}
	return nil
}

func (index *pendingIndex) retire(ctx context.Context, orderID string) {
	client, key := index.handle()
	if client == nil {
		return
	}
	// A failed retirement costs one wasted read next tick, so it is logged by
	// the caller's return path rather than failing the read it rides on.
	_, _ = client.ZRem(ctx, key, orderID)
}

func (index *pendingIndex) handle() (indexStore, string) {
	index.mu.Lock()
	defer index.mu.Unlock()
	return index.client, index.key
}

// PendingOrders returns up to limit orders that are due now, oldest first.
//
// Entries whose score has not come due are left alone: the set is ordered by
// score, so the first one that is not due means none behind it is either, and
// spending the batch on orders the service would refuse wastes the tick.
func (index *pendingIndex) PendingOrders(ctx context.Context, limit int) ([]string, error) {
	if limit <= 0 {
		return nil, nil
	}
	client, key := index.handle()
	if client == nil {
		return nil, fmt.Errorf("pending index: not bound to a registry")
	}
	entries, err := client.ZRangeWithScores(ctx, key, 0, int64(limit-1))
	if err != nil {
		return nil, fmt.Errorf("pending index: read: %w", err)
	}
	now := index.clock()
	due := make([]string, 0, len(entries))
	for _, entry := range entries {
		if int64(entry.Score) > now {
			break
		}
		finished, err := index.finished(ctx, entry.Member)
		if err != nil {
			// The order could not be read, so this entry's fate is unknown.
			// Keeping it is the safe answer: an attempt on an order that is
			// already delivered is a no-op, while retiring one that is not is
			// a paid order nobody looks at again.
			return nil, err
		}
		if finished {
			index.retire(ctx, entry.Member)
			continue
		}
		due = append(due, entry.Member)
	}
	return due, nil
}

// finished asks the service whether this order still needs delivery work.
func (index *pendingIndex) finished(ctx context.Context, orderID string) (bool, error) {
	orders, err := index.platformService()
	if err != nil {
		return false, err
	}
	order, found, err := orders.Order(ctx, orderID)
	if err != nil {
		return false, fmt.Errorf("pending index: read order %s: %w", orderID, err)
	}
	// An order id in the index with no record behind it can never be
	// delivered; it would be read every tick forever.
	return !found || order.Terminal(), nil
}

func (index *pendingIndex) platformService() (platform.Platform, error) {
	index.mu.Lock()
	defer index.mu.Unlock()
	if index.orders != nil {
		return index.orders, nil
	}
	if index.registry == nil {
		return nil, fmt.Errorf("pending index: not bound to a registry")
	}
	service, ok := app.Lookup[platform.Platform](index.registry, platform.CapabilityName)
	if !ok || service == nil {
		return nil, fmt.Errorf("pending index: capability %q not found in this process", platform.CapabilityName)
	}
	index.orders = service
	return service, nil
}

func (index *pendingIndex) clock() int64 {
	index.mu.Lock()
	now := index.now
	index.mu.Unlock()
	if now == nil {
		return nowUnix()
	}
	return now()
}

var (
	_ platform.PendingOrders = (*pendingIndex)(nil)
	_ platform.RegistryBound = (*pendingIndex)(nil)
)
