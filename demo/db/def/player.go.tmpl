package dbdef

//roost:dao coll=player db=game
type PlayerDao struct {
	Name  string          `bson:"name" dao:"persist,sync"`
	Level int32           `bson:"level" dao:"persist,sync"`
	Exp   int64           `bson:"exp" dao:"persist,sync"`
	Gold  int64           `bson:"gold" dao:"persist,sync"`
	Items map[int64]int32 `bson:"items" dao:"persist,sync,map=fast"`
	// DungeonClaims is the exactly-once ledger for dungeon clear rewards:
	// run id -> the run's resolution time. The claim transaction records the
	// run here and pays only when it is the one that recorded it. Entries
	// are pruned by the same window that decides whether a claim is still
	// admissible; see game/dungeon for why those have to be one number
	// (RR-20260918-04).
	// PosX / PosY are where the player is, and this is the ONLY place that
	// answers that. The scene's AOI keeps an index of positions so it can
	// answer "who is near whom" without walking every player, but an index is
	// not a second authority: it is written from the one path that writes
	// these fields (MapComponent.MoveTo) and never read as the answer to
	// "where is X". Persisted, so a player logs back in where they left; and
	// synced, so moving is replicated by the same pipeline as everything else
	// — no separate movement broadcast.
	PosX int64 `bson:"pos_x" dao:"persist,sync"`
	PosY int64 `bson:"pos_y" dao:"persist,sync"`
	// SceneID is which scene the player is in, 0 for nowhere.
	SceneID int64 `bson:"scene_id" dao:"persist,sync"`
	// AttrBase is the player's own attribute values: what they are with
	// nothing applied. AttrID -> value, the bulk form the framework's
	// Profile exports and loads (game/entities/player/attribute_component.go).
	// Persisted AND replicated: it is state the server owns and the client
	// renders.
	AttrBase map[int32]int64 `bson:"attr_base" dao:"persist,sync,map=fast"`
	// AttrFinal is the composed view — base plus every layer — and it is
	// deliberately `nopersist,sync`: storing a value that is derivable from
	// what is already stored buys nothing and creates a second truth that can
	// disagree with the first. It is recomputed when the entity loads, and
	// replicated because it is what a client draws.
	AttrFinal map[int32]int64 `bson:"attr_final" dao:"nopersist,sync,map=fast"`
	DungeonClaims map[string]int64 `bson:"dungeon_claims" dao:"persist,map=fast"`
	// MailClaims is the same ledger for mail attachments: mail id → the
	// MAIL's expiry, as the mail service reported it with the reservation. It closes the window the three-step claim leaves open —
	// reserve and grant succeed, the commit is lost, and the retry would
	// grant a second stack (see game/controllers/player/claim_mail.go).
	MailClaims map[string]int64 `bson:"mail_claims" dao:"persist,map=fast"`
}
