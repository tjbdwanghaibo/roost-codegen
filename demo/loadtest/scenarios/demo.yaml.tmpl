# One robot's life: connect and hand over the credential, make sure the Player
# exists, chat on the world channel and read it back, add an item, earn
# exp (the reward mail it sends is then listed and claimed), earn enough exp to level up (which sends a reward mail
# through the effect chain), queue for a duel until matched, read the World's
# counters. Run an even number of robots: duels need pairs. Param keys are the request fields' snake_case
# names; a value can also come from the robot's blackboard.
#
# The same file is the demo's regression test: `go run ./cmd/loadtest` fails
# when any step returns a non-zero code or the thresholds are exceeded.
scenarios:
  - name: demo
    node:
      sequence:
        - action: connect
        - action: enter_game
        # Chat: say hello on the world channel (a bus call into the chat
        # service). The game fans the stored line back as a push (msg 10101)
        # to every online player, the sender included — but it pushes before
        # it answers, so the robot's own copy can land before wait_push is
        # listening and be dropped as an unsolicited push. Hence the selector:
        # a push within half a second (its own, or another robot's), or move
        # on; chat_history is the check that the line is there either way
        # (the reconnect path). The wait is short because it counts toward
        # the scenario cost the p95 threshold judges.
        - action: send_chat
          param:
            kind: world
            target: 1
            text: hello from a robot
        - selector:
            - action: wait_push
              param:
                msg: 10101
                timeout: 500ms
            - wait: 10ms
        - action: chat_history
          param:
            kind: world
            target: 1
            limit: 20
        - action: add_item
          param:
            item_id: 1001
            count: 1
        - action: add_exp
          param:
            amount: 150
        # The level-up sent a reward mail through the effect chain
        # (asynchronous, usually well under a second). Poll the mailbox until
        # it is there, then claim the attachment into the Bag: the mail
        # service's exactly-once claim around one Nest transaction.
        - retry:
            times: 20
            node:
              sequence:
                - wait: 250ms
                - action: list_mail
                  param:
                    limit: 20
        - action: claim_mail
        # Matchmaking: join the duel queue, then poll until the game's
        # matchmaker has paired this robot with another one. The ticket id
        # comes from the blackboard, where join_queue's OnResp put it.
        - action: join_queue
          param:
            mode: duel
        # The matchmaker pushes MatchFound (msg 10100) to both players; wait
        # for it. If the push was missed (10s), fall back to polling the
        # ticket — the ticket carries the match id either way.
        - selector:
            - action: wait_push
              param:
                msg: 10100
                timeout: 10s
            - retry:
                times: 20
                node:
                  sequence:
                    - wait: 250ms
                    - action: poll_match
        - action: world_stats
